{
  "expo": {
    "name": "bankroll",
    "slug": "bankroll",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121920"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121920"
      },
      "package": "com.anonymous.bankroll"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [],
    "newArchEnabled": true
  }
}
